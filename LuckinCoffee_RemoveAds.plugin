#!name=瑞幸咖啡去广告 v2
#!desc=响应侧改写：只清广告内容，保留 code/loginState/uid 信封和网关响应头；不再全局拦截腾讯 HTTPDNS，也不碰未验证的下单流程接口
#!author=zq
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/9d/3b/9a/9d3b9ad3-4b4c-8dae-68c5-d6a1594d20e6/AppIcon-0-0-1x_U007emarketing-0-6-0-85-220.png/256x256bb.png
#!date=2026-11-14

[Argument]
order_popup = switch,false,tag=下单页弹窗/推荐（默认关）
debug = switch,false,tag=调试日志

[Script]
# 开屏广告 + 首页弹窗素材
# 旧做法：http-request 阶段直接伪造响应 → 丢掉信封和响应头（怀疑的掉登录根因）
# 新做法：让请求正常到达服务器，只在响应侧清空 content
http-response ^https:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew script-path=https://cdn.jsdelivr.net/gh/27149/Loon-Scripts@main/luckin_ad_strip.js, argument={debug}, requires-body=true, timeout=20, tag=瑞幸开屏

# 下单确认页弹窗（默认关闭，先隔离掉登录变量；确认无影响后再打开）
http-response ^https:\/\/capi\.lkcoffee\.com\/resource\/core\/v1\/order\/popwindow script-path=https://cdn.jsdelivr.net/gh/27149/Loon-Scripts@main/luckin_ad_strip.js, argument={debug}, enabled={order_popup}, requires-body=true, timeout=20, tag=瑞幸下单弹窗

# 下单页商品推荐（同上，默认关闭）
http-response ^https:\/\/capi\.lkcoffee\.com\/resource\/core\/v2\/product\/preRecommender script-path=https://cdn.jsdelivr.net/gh/27149/Loon-Scripts@main/luckin_ad_strip.js, argument={debug}, enabled={order_popup}, requires-body=true, timeout=20, tag=瑞幸下单推荐

[MITM]
hostname = %APPEND% capi.lkcoffee.com, 152.136.248.40
