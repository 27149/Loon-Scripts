#!name=瑞幸咖啡去广告 v17
#!desc=v17 (2026-11-17 13:45) 首页弹窗改为「回源真实页面 + 注入自动关闭」：不再用 url reject（它在 Loon 里返回 404，会让 WebView 卡在无按钮蒙层）；注入失败则原样放行，最差也只是弹窗正常显示
#!author=zq
#!icon=https://raw.githubusercontent.com/27149/Loon-Scripts/main/luckin/icon.png
#!date=2026-11-17

[Script]
# capi：开屏 + effect/modules + preRecommender（带安全阀）
# mkt：首页弹窗页面，回源后注入自动关闭脚本
http-request ^https:\/\/(capi|mkt)\.lkcoffee\.com\/ script-path=https://raw.githubusercontent.com/27149/Loon-Scripts/main/luckin/luckin_v17.js, requires-body=false, timeout=10, tag=瑞幸去广告

[MITM]
hostname = %APPEND% capi.lkcoffee.com, mkt.lkcoffee.com, 152.136.248.40
