#!name=瑞幸咖啡去广告
#!desc=去除瑞幸咖啡 App 开屏广告（含首页弹窗广告位）与下单确认页弹窗；用加密空响应替代，避免「网络不可用」提示
#!author=zq
#!date=2026-11-14

[Rule]
# 瑞幸用腾讯 HTTPDNS 把 capi.lkcoffee.com 解析成 IP 后直连，绕过 MITM 主机名匹配。
# 拒绝 HTTPDNS 服务器，迫使 App 回落到系统 DNS（走域名，插件才能生效）。
IP-CIDR,119.29.29.87/32,REJECT,no-resolve
IP-CIDR,119.28.28.87/32,REJECT,no-resolve
IP-CIDR,119.29.29.89/32,REJECT,no-resolve

[Script]
# 广告位配置：开屏广告 / 首页弹窗素材
http-request ^https:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew script-path=https://raw.githubusercontent.com/27149/Loon-Scripts/main/luckin_empty.js, requires-body=false, timeout=10, tag=瑞幸开屏广告

# 下单确认页弹窗配置
http-request ^https:\/\/capi\.lkcoffee\.com\/resource\/core\/v1\/order\/popwindow script-path=https://raw.githubusercontent.com/27149/Loon-Scripts/main/luckin_empty.js, requires-body=false, timeout=10, tag=瑞幸下单弹窗

# 下单页商品推荐（试验：疑似下单页弹窗的数据来源）
http-request ^https:\/\/capi\.lkcoffee\.com\/resource\/core\/v2\/product\/preRecommender script-path=https://raw.githubusercontent.com/27149/Loon-Scripts/main/luckin_empty.js, requires-body=false, timeout=10, tag=瑞幸下单推荐

[MITM]
hostname = %APPEND% capi.lkcoffee.com, 152.136.248.40
