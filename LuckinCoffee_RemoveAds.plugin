#!name=瑞幸咖啡去广告 v4
#!desc=还原你原本能用的「请求阶段拦截」机制（已验证可去广告），只把脚本托管换成 jsDelivr（原来的 raw 地址已 404），并加一行拦截日志用于确认 MITM 是否命中
#!author=zq
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/9d/3b/9a/9d3b9ad3-4b4c-8dae-68c5-d6a1594d20e6/AppIcon-0-0-1x_U007emarketing-0-6-0-85-220.png/256x256bb.png
#!date=2026-11-14

[Rule]
# 瑞幸用腾讯 HTTPDNS 把 capi.lkcoffee.com 解析成 IP 后直连，会绕过按域名匹配的 MITM。
# 拒绝 HTTPDNS 服务器，迫使 App 回落到系统 DNS（走域名，插件才能生效）。
IP-CIDR,119.29.29.87/32,REJECT,no-resolve
IP-CIDR,119.28.28.87/32,REJECT,no-resolve
IP-CIDR,119.29.29.89/32,REJECT,no-resolve

[Script]
# 开屏广告 + 首页弹窗素材
http-request ^https:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew script-path=https://cdn.jsdelivr.net/gh/27149/Loon-Scripts@fafdfdb9fc7cda320414c42aeab0f5234aae8f3a/luckin_empty.js, requires-body=false, timeout=10, tag=瑞幸开屏广告

# 下单确认页弹窗
http-request ^https:\/\/capi\.lkcoffee\.com\/resource\/core\/v1\/order\/popwindow script-path=https://cdn.jsdelivr.net/gh/27149/Loon-Scripts@fafdfdb9fc7cda320414c42aeab0f5234aae8f3a/luckin_empty.js, requires-body=false, timeout=10, tag=瑞幸下单弹窗

# 下单页商品推荐
http-request ^https:\/\/capi\.lkcoffee\.com\/resource\/core\/v2\/product\/preRecommender script-path=https://cdn.jsdelivr.net/gh/27149/Loon-Scripts@fafdfdb9fc7cda320414c42aeab0f5234aae8f3a/luckin_empty.js, requires-body=false, timeout=10, tag=瑞幸下单推荐

[MITM]
hostname = %APPEND% capi.lkcoffee.com, 152.136.248.40
