#!name = 瑞幸咖啡去广告
#!desc = 去除瑞幸咖啡开屏广告、H5弹窗、订单页弹窗
#!author = Claude
#!date = 2026-11-13

[Rewrite]
# 开屏 (已验证: 404 能去掉开屏, 代价是进 app 会提示网络不可用)
^https?:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew url reject
# 首页 H5 弹窗
^https?:\/\/mkt\.lkcoffee\.com\/webdialog url reject
# 订单页弹窗 (试验: 支付前推荐)
^https?:\/\/capi\.lkcoffee\.com\/resource\/core\/v2\/product\/preRecommender url reject

[MITM]
hostname = capi.lkcoffee.com, mkt.lkcoffee.com
